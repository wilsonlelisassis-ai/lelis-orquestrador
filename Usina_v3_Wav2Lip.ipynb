   "source": [
    "api_code = '''\nimport os, uuid, time, base64, tempfile, subprocess\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.responses import FileResponse\nfrom fastapi.staticfiles import StaticFiles\nfrom fastapi.middleware.cors import CORSMiddleware\nfrom pydantic import BaseModel\n\nWAV2LIP_DIR = "/content/Wav2Lip"\nCHECKPOINT  = "/content/Wav2Lip/checkpoints/wav2lip_gan.pth"\nIDLE_VIDEO  = "/content/usina_v3/idle_wilson.mp4"\nOUTPUT_DIR  = "/content/usina_v3/output"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\napp = FastAPI(title="Usina v3")\napp.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])\napp.mount("/videos", StaticFiles(directory=OUTPUT_DIR), name="videos")\n\nclass GerarReq(BaseModel):\n    audio_base64: str\n    candidato: str = "wilson"\n\n@app.get("/status")\ndef status():\n    import torch\n    return {"status": "ok", "versao": "3.0.0", "motor": "wav2lip_gan", "gpu": torch.cuda.get_device_name(0) if torch.cuda.is_available() else "CPU", "idle_ok": os.path.exists(IDLE_VIDEO), "ckpt_ok": os.path.exists(CHECKPOINT)}\n\n@app.post("/gerar_video")\nasync def gerar_video(req: GerarReq):\n    t0 = time.time()\n    if not os.path.exists(IDLE_VIDEO): raise HTTPException(400, "Video idle nao encontrado")\n    if not os.path.exists(CHECKPOINT): raise HTTPException(500, "Pesos Wav2Lip nao encontrados")\n    with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as f:\n        f.write(base64.b64decode(req.audio_base64))\n        mp3 = f.name\n    wav = mp3.replace(".mp3", ".wav")\n    subprocess.run(["ffmpeg", "-y", "-i", mp3, "-ar", "16000", "-ac", "1", wav], capture_output=True)\n    nome = f"lipsync_{req.candidato}_{int(time.time())}_{uuid.uuid4().hex[:6]}.mp4"\n    out  = os.path.join(OUTPUT_DIR, nome)\n    cmd  = ["python", "inference.py", "--checkpoint_path", CHECKPOINT, "--face", IDLE_VIDEO, "--audio", wav, "--outfile", out, "--resize_factor", "1", "--nosmooth"]\n    r = subprocess.run(cmd, capture_output=True, text=True, cwd=WAV2LIP_DIR)\n    for p in [mp3, wav]:\n        try: os.unlink(p)\n        except: pass\n    if r.returncode != 0 or not os.path.exists(out): raise HTTPException(500, f"Wav2Lip falhou: {r.stderr[-300:]}")\n    print(f"[Usina v3] {nome} em {round(time.time()-t0,2)}s")\n    return {"status": "ok", "video_url": f"/videos/{nome}", "tempo_s": round(time.time()-t0, 2)}\n\n@app.post("/transcrever")\nasync def transcrever(data: dict):\n    import whisper\n    b64 = data.get("audio_base64", "")\n    if not b64: return {"text": ""}\n    ext = "mp4" if "mp4" in data.get("mime_type","") else "webm"\n    with tempfile.NamedTemporaryFile(suffix=f".{ext}", delete=False) as f:\n        f.write(base64.b64decode(b64))\n        tmp = f.name\n    wav = tmp + ".wav"\n    subprocess.run(["ffmpeg", "-y", "-i", tmp, "-ar", "16000", "-ac", "1", wav], capture_output=True)\n    try:\n        m = whisper.load_model("small")\n        return {"text": m.transcribe(wav, language="pt", fp16=True).get("text","").strip()}\n    except Exception as e:\n        return {"text": "", "erro": str(e)}\n    finally:\n        for p in [tmp, wav]:\n            try: os.unlink(p)\n            except: pass\n\nif __name__ == "__main__":\n    import uvicorn\n    uvicorn.run(app, host="0.0.0.0", port=7860, log_level="info")\n'''\n",
    "with open('/content/usina_v3/api.py', 'w') as f:\n",
    "    f.write(api_code)\n",
    "print('API escrita em /content/usina_v3/api.py')"
   ]

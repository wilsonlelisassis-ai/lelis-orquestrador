    "from pyngrok import ngrok\n",
    "import subprocess, threading, time, os\n",
    "if NGROK_TOKEN:\n",
    "    ngrok.set_auth_token(NGROK_TOKEN)\n",
    "    print('Token ngrok configurado')\n",
    "else:\n",
    "    print('Sem token ngrok - sessao expira em 2h')\n",
    "def run():\n",
    "    os.chdir('/content/usina_v3')\n",
    "    subprocess.run(['python', 'api.py'])\n",
    "t = threading.Thread(target=run, daemon=True)\n",
    "t.start()\n",
    "time.sleep(5)\n",
    "tunnel = ngrok.connect(API_PORT, 'http')\n",
    "url = tunnel.public_url\n",
    "print()\n",
    "print('='*60)\n",
    "print('USINA v3 NO AR!')\n",
    "print('='*60)\n",
    "print(f'URL: {url}')\n",
    "print()\n",
    "print('Configure no seu servidor:')\n",
    "print(f'   USINA_V3_URL={url}')\n",
    "print(f'Teste: {url}/status')\n",
    "print('='*60)"
   ]
